package main

import (
	"math"
	"math/rand"
	"sort"
)

type SimParams struct {
	MutationRate       float64
	BaseDeathRate      float64
	DivisionATP        float64
	MaxCells           int

	TranslationK       float64
	MRNADegradation    float64
	ProteinDegradation float64
	EnzymeKcat         float64
	GlucoseInflux      float64
	ATPBasal           float64
	EnvGlucose         float64
}

func DefaultParams() SimParams {
	return SimParams{
		MutationRate:       0.05,   // per division
		BaseDeathRate:      0.002,
		DivisionATP:        10.0,
		MaxCells:           300,
		TranslationK:       1.5,    // proteins per mRNA per tick
		MRNADegradation:    0.15,   // ~5 min half-life
		ProteinDegradation: 0.01,   // ~70 min half-life
		EnzymeKcat:         0.5,
		GlucoseInflux:      1.0,
		ATPBasal:           0.1,
		EnvGlucose:         50.0,
	}
}

type Sim struct {
	Tick     int
	Cells    []*Cell
	NextID   int
	Params   SimParams
	Rng      *rand.Rand
	EnvPool  float64
	History  []HistoryPoint
}

type HistoryPoint struct {
	Tick  int
	Alive int
	ATP   float64
}

func NewSim(p SimParams, seed int64) *Sim {
	s := &Sim{
		Params:  p,
		NextID:  1,
		Rng:     rand.New(rand.NewSource(seed)),
		EnvPool: p.EnvGlucose * 100,
	}
	for i := 0; i < 3; i++ {
		s.Cells = append(s.Cells, s.newCell(0))
	}
	return s
}

func (s *Sim) newCell(parent int) *Cell {
	c := &Cell{
		ID:         s.NextID,
		ParentID:   parent,
		Generation: 0,
		Alive:      true,
		Genome:     NewGenome(),
		MRNA:       map[string]float64{},
		Proteins:   map[string]float64{},
		Glucose:    10,
		ATP:        5,
	}
	s.NextID++
	return c
}

func (s *Sim) Step() {
	p := s.Params

	for _, c := range s.Cells {
		if !c.Alive {
			continue
		}
		c.Age++

		// 1. Glucose import from environment
		imported := math.Min(c.GlucoseMax(), p.GlucoseInflux)
		if s.EnvPool >= imported {
			s.EnvPool -= imported
			c.Glucose += imported
		} else {
			c.Glucose += s.EnvPool
			s.EnvPool = 0
		}

		// 2. Transcription (DNA → mRNA)
		for _, gene := range c.Genome.Genes {
			occ := c.PromoterOccupancy(gene)
			rate := gene.BasalTranscription * occ
			c.MRNA[gene.Name] += rate
		}

		// 3. Translation (mRNA → protein)
		for _, gene := range c.Genome.Genes {
			mrna := c.MRNA[gene.Name]
			if mrna <= 0 {
				continue
			}
			rbs := c.Genome.RBSStrength(gene)
			rate := p.TranslationK * mrna * rbs
			c.Proteins[gene.Product] += rate
			c.MRNA[gene.Name] = math.Max(0, mrna-rate*0.1)
		}

		// 4. mRNA degradation
		for name, v := range c.MRNA {
			deg := v * p.MRNADegradation
			nv := v - deg
			if nv < 0.01 {
				delete(c.MRNA, name)
			} else {
				c.MRNA[name] = nv
			}
		}

		// 5. Protein degradation
		for name, v := range c.Proteins {
			deg := v * p.ProteinDegradation
			nv := v - deg
			if nv < 0.01 {
				delete(c.Proteins, name)
			} else {
				c.Proteins[name] = nv
			}
		}

		// 6. Metabolism: MetA_enzyme converts glucose to ATP (Michaelis-Menten)
		enzyme := c.Proteins["MetA_enzyme"]
		if enzyme > 0 && c.Glucose > 0 {
			km := 5.0
			rate := p.EnzymeKcat * enzyme * (c.Glucose / (km + c.Glucose))
			maxByGlucose := rate
			if maxByGlucose > c.Glucose {
				maxByGlucose = c.Glucose
			}
			c.Glucose -= maxByGlucose
			c.ATP += maxByGlucose
			c.TotalATPProduced += maxByGlucose
		}

		// 7. Basal ATP consumption
		c.ATP -= p.ATPBasal
		if c.ATP < 0 {
			c.ATP = 0
		}

		// 8. Death — starvation or stochastic
		if c.ATP < 0.1 && c.Glucose < 0.1 {
			c.Alive = false
			c.DeathCause = "starvation"
			continue
		}
		if s.Rng.Float64() < p.BaseDeathRate {
			c.Alive = false
			c.DeathCause = "stochastic"
			continue
		}
	}

	// 9. Division
	var newborns []*Cell
	aliveCount := s.aliveCount()
	for _, c := range s.Cells {
		if !c.Alive {
			continue
		}
		if c.ATP >= p.DivisionATP && aliveCount+len(newborns) < p.MaxCells {
			daughter := c.CloneDaughter(s.NextID, s.Rng)
			s.NextID++
			c.Divisions++

			// Mutation chance
			if s.Rng.Float64() < p.MutationRate {
				kind, pos := daughter.Genome.mutate(s.Rng)
				_ = kind
				_ = pos
			}
			// Energy cost
			c.ATP -= p.DivisionATP / 2
			daughter.ATP -= p.DivisionATP / 2
			if c.ATP < 0 { c.ATP = 0 }
			if daughter.ATP < 0 { daughter.ATP = 0 }

			newborns = append(newborns, daughter)
		}
	}
	s.Cells = append(s.Cells, newborns...)
	s.Tick++

	// Record
	totalATP := 0.0
	alive := 0
	for _, c := range s.Cells {
		if c.Alive {
			alive++
			totalATP += c.ATP
		}
	}
	s.History = append(s.History, HistoryPoint{Tick: s.Tick, Alive: alive, ATP: totalATP})
	if len(s.History) > 500 {
		s.History = s.History[len(s.History)-500:]
	}
}

func (c *Cell) GlucoseMax() float64 { return 20.0 }

func (s *Sim) aliveCount() int {
	n := 0
	for _, c := range s.Cells {
		if c.Alive {
			n++
		}
	}
	return n
}

func (s *Sim) AliveCount() int { return s.aliveCount() }

func (s *Sim) MaxGen() int {
	m := 0
	for _, c := range s.Cells {
		if c.Generation > m {
			m = c.Generation
		}
	}
	return m
}

func (s *Sim) SortedCells() []*Cell {
	out := make([]*Cell, len(s.Cells))
	copy(out, s.Cells)
	sort.Slice(out, func(i, j int) bool {
		if out[i].Alive != out[j].Alive {
			return out[i].Alive
		}
		return out[i].ID < out[j].ID
	})
	return out
}

func (s *Sim) GlobalProteinLevels() map[string]float64 {
	out := map[string]float64{}
	for _, c := range s.Cells {
		if !c.Alive {
			continue
		}
		for k, v := range c.Proteins {
			out[k] += v
		}
	}
	return out
}

func (s *Sim) GlobalMRNALevels() map[string]float64 {
	out := map[string]float64{}
	for _, c := range s.Cells {
		if !c.Alive {
			continue
		}
		for k, v := range c.MRNA {
			out[k] += v
		}
	}
	return out
}
